{
  "uid": "bazaar-gateway",
  "title": "BAZAAR API Gateway",
  "schemaVersion": 39,
  "refresh": "30s",
  "timezone": "utc",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "Gateway responses per second, grouped by HTTP status. 429 means the Redis rate limit refused the request.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (routeId, httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_count[5m]))", "legendFormat": "{{routeId}} {{httpStatusCode}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average latency by route",
      "description": "Average gateway time by route, including the downstream call. Route ids stay low-cardinality. Paths that contain an id are not split out.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_sum[5m])) / sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count[5m]))", "legendFormat": "{{routeId}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate limited",
      "description": "Requests the gateway rejected before they reached a service. Redis fail-open means a Redis outage does not produce these.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{httpStatusCode=\"429\"}[5m]))", "legendFormat": "429", "refId": "A" }]
    }
  ]
}
