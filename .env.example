# BAZAAR local configuration contract.
# Copy to .env for local process runs. Do not commit .env.
# Containers receive the same variables from Compose or Kubernetes.
# Passwords below are for the local Compose stack only. They are not production secrets.

# Host port for a locally started process. Containers listen on 8080
# and publish a host port through Compose, or stay on the cluster network.
SERVER_PORT=8080

# Storefront server-side gateway address. Read at runtime.
# Local processes:
API_GATEWAY_URL=http://localhost:8080
# Compose and Kubernetes use the in-cluster DNS name instead:
# API_GATEWAY_URL=http://api-gateway:8080

# Browser origin allowed to call the gateway directly during development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gateway downstream addresses for a local multi-process run.
# Compose and Kubernetes replace localhost with service DNS names on port 8080.
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085

# Local databases. Compose creates these users on an empty Postgres volume.
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USERNAME=identity_user
DB_PASSWORD=identity_local

# Token issuer seen by the browser and by resource servers.
# Inside Compose, services fetch keys from the keycloak DNS name instead.
KEYCLOAK_ISSUER_URI=http://localhost:8088/realms/bazaar
KEYCLOAK_JWK_SET_URI=http://localhost:8088/realms/bazaar/protocol/openid-connect/certs

# Local Keycloak bootstrap and realm users. Direct access grants are for local curl only.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_CUSTOMER_USERNAME=customer
KEYCLOAK_CUSTOMER_PASSWORD=customer_local
KEYCLOAK_SELLER_USERNAME=seller
KEYCLOAK_SELLER_PASSWORD=seller_local
KEYCLOAK_REALM_ADMIN_USERNAME=admin
KEYCLOAK_REALM_ADMIN_PASSWORD=admin_local
KEYCLOAK_OPERATOR_USERNAME=operator
KEYCLOAK_OPERATOR_PASSWORD=operator_local
